---
import { ELSEWHERE_LINKS } from '../lib/elsewhere.mjs';

const footerElsewhereLinks = [...ELSEWHERE_LINKS].sort((first, second) => first.footerOrder - second.footerOrder);
---
<footer class="site-footer">
  <div class="site-footer-inner">
    <nav aria-label="Footer profile links">
      {footerElsewhereLinks.map((link) => <a href={link.href} aria-label={link.accessibleName}>{link.label}</a>)}
    </nav>
    <p>© {new Date().getFullYear()} Kaleb Cole.</p>
  </div>
</footer>
