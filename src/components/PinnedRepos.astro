---
import { getPinnedRepos } from '../lib/github.mjs';

interface Props {
  limit?: number;
  variant?: 'index' | 'home';
  layoutMotion?: boolean;
}

const { limit, variant = 'index', layoutMotion = false } = Astro.props;
const { repos, status, verifiedAt } = getPinnedRepos();
// The series is featured above with its website link, so skip its GitHub pin.
const featuredRepoUrls = new Set(['https://github.com/microsoft/student-learning-series']);
const unfeaturedRepos = repos.filter((repo) => !featuredRepoUrls.has(repo.url.replace(/\/$/, '')));
const displayedRepos = typeof limit === 'number' ? unfeaturedRepos.slice(0, Math.max(0, limit - 1)) : unfeaturedRepos;
const githubPreviewUrl = (url: string) => {
  const [, owner, name] = new URL(url).pathname.replace(/\/$/, '').split('/');
  return `https://opengraph.githubassets.com/1/${owner}/${name}`;
};
const repoOverrides = {
  'KalebCole/partiful-cli': {
    name: 'partiful-cli',
    description: 'Reverse-engineered Partiful’s API into an agentic CLI for managing events. My favorite workflows match invitations against my calendar and help me find events around Seattle.',
    url: 'https://kalebcole.github.io/partiful-cli/',
    image: '/projects/partiful-cli-website.webp',
    imageWidth: 1200,
    imageHeight: 630,
    imageAlt: 'Partiful CLI homepage with the headline Your agent has the party covered',
  },
  'KalebCole/uprint-cli': {
    name: 'uprint-cli',
    description: 'Agentic CLI for Microsoft Employees to print hassle-free at the Redmond campus',
    url: 'https://kalebcole.github.io/uprint-cli/',
    image: '/projects/uprint-website.webp',
    imageWidth: 1200,
    imageHeight: 630,
    imageAlt: 'uprint website homepage with its terminal printing workflow',
  },
};
const displayedProjects = displayedRepos.map((repo) => {
  const identity = new URL(repo.url).pathname.replace(/\/$/, '').slice(1);
  const override = repoOverrides[identity as keyof typeof repoOverrides];
  return {
    ...repo,
    ...override,
    image: override?.image ?? githubPreviewUrl(repo.url),
    imageWidth: override?.imageWidth ?? 1200,
    imageHeight: override?.imageHeight ?? 600,
    imageAlt: override?.imageAlt ?? `GitHub preview for ${identity}`,
  };
});
const Heading = variant === 'home' ? 'h3' : 'h2';
---
<ul class:list={['project-index', { 'home-project-index': variant === 'home' }]}>
  <li class="project-index-row project-index-row-series" data-home-layout-project={layoutMotion ? '' : undefined}>
    <a class="project-visual" data-motion-beat href="https://aka.ms/student-learning-series-website">
      <img
        src="https://microsoft.github.io/student-learning-series/assets/share-plate.jpg"
        width="1200"
        height="630"
        loading="lazy"
        decoding="async"
        alt="Build your personal brand with Copilot series preview"
      />
    </a>
    <div class="project-index-copy" data-motion-beat>
      <Heading><a href="https://aka.ms/student-learning-series-website" class="repo-name">Build Your Personal Brand with Copilot<span aria-hidden="true"> ↗</span></a></Heading>
      <p class="repo-desc">A YouTube series for the Microsoft Developer channel that guides college students and beginners through turning an existing PDF resume into a portfolio website with GitHub Copilot.</p>
      <p class="project-role">I helped create the series with a team and built its website.</p>
    </div>
  </li>
  {displayedProjects.map((r) => (
    <li class="project-index-row" data-home-layout-project={layoutMotion ? '' : undefined}>
      <a class="project-visual" data-motion-beat href={r.url}>
        <img
          src={r.image}
          width={r.imageWidth}
          height={r.imageHeight}
          loading="lazy"
          decoding="async"
          alt={r.imageAlt}
        />
      </a>
      <div class="project-index-copy" data-motion-beat>
        <Heading><a href={r.url} class="repo-name">{r.name}<span aria-hidden="true"> ↗</span></a></Heading>
        {r.description && <p class="repo-desc">{r.description}</p>}
      </div>
    </li>
  ))}
</ul>
{(status === 'ready' || status === 'stale') && (
  <p class="project-fallback" data-github-snapshot-verified-at={verifiedAt} hidden={status !== 'stale'}>
    This GitHub project list may be out of date.
  </p>
)}
{(status === 'missing' || status === 'invalid') && (
  <p class="project-fallback">
    The GitHub project list is unavailable right now.
  </p>
)}

<script>
  import { showStaleGitHubSnapshotStatus } from '../scripts/github-snapshot-age.mjs';

  showStaleGitHubSnapshotStatus();
</script>
