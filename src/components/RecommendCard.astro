---
import type { CollectionEntry } from 'astro:content';
import thumbnails from '../data/recommend-thumbnails.json';
import { THUMBNAIL_SIZES } from '../lib/recommend-thumbnails.mjs';

interface Props {
  item: CollectionEntry<'recommends'>;
  motion?: boolean;
  layoutMotion?: boolean;
  headingLevel?: 2 | 3;
  /** The above-the-fold card: load its thumbnail eagerly at high priority (it is the page's LCP image). */
  priority?: boolean;
}

const { item, motion = false, layoutMotion = false, headingLevel = 2, priority = false } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const mediumMeta = {
  read: { label: 'Read', path: 'M6 4.75h8a3 3 0 0 1 3 3v11.5h-8a3 3 0 0 0-3 3V4.75Zm12 0h.5a2.5 2.5 0 0 1 2.5 2.5v12h-9a3 3 0 0 0-3 3' },
  watch: { label: 'Watch', path: 'm9 7 10 5-10 5V7Zm-3-3.25h12A3.25 3.25 0 0 1 21.25 7v10A3.25 3.25 0 0 1 18 20.25H6A3.25 3.25 0 0 1 2.75 17V7A3.25 3.25 0 0 1 6 3.75Z' },
  listen: { label: 'Listen', path: 'M4 13v-1a8 8 0 0 1 16 0v1M4 13h2.5A1.5 1.5 0 0 1 8 14.5v4A1.5 1.5 0 0 1 6.5 20H6a2 2 0 0 1-2-2v-5Zm16 0h-2.5a1.5 1.5 0 0 0-1.5 1.5v4a1.5 1.5 0 0 0 1.5 1.5h.5a2 2 0 0 0 2-2v-5Z' },
};
const medium = mediumMeta[item.data.medium];
// Local WebP copies, generated by the prebuild step (`npm run recommend-thumbnails`). If they
// are missing or were made from a different image URL (possible in `npm run dev`, which skips
// prebuild), fall back to the source URL; certify fails in that case.
const thumbnail = (thumbnails as Record<string, { source: string; candidates: { src: string; width: number; height: number }[] }>)[item.id];
const localCandidates = item.data.image && thumbnail?.source === item.data.image ? thumbnail.candidates : undefined;
const thumbnailSrc = localCandidates
  ? (localCandidates.find((candidate) => candidate.width === 640) ?? localCandidates[localCandidates.length - 1]).src
  : item.data.image;
const thumbnailSrcset = localCandidates?.map((candidate) => `${candidate.src} ${candidate.width}w`).join(', ');
const formattedDate = item.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
---
<article
    class:list={['rec', { 'rec-has-image': item.data.image, 'rec-no-image': !item.data.image }]}
    data-recommendation
    data-medium={item.data.medium}
    data-motion-beat={motion ? '' : undefined}
  >
  <div class:list={['rec-visual', { 'rec-visual-fallback': !item.data.image }]} data-home-layout-recommendation={layoutMotion ? '' : undefined}>
    {item.data.image ? (
      <img
        class="rec-thumb"
        src={thumbnailSrc}
        srcset={thumbnailSrcset}
        sizes={thumbnailSrcset ? THUMBNAIL_SIZES : undefined}
        alt=""
        width="640"
        height="360"
        loading={priority ? undefined : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding="async"
      />
    ) : (
      <svg class="rec-medium-mark" viewBox="0 0 24 24" aria-hidden="true">
        <path d={medium.path}></path>
      </svg>
    )}
    <span class="rec-medium">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d={medium.path}></path></svg>
      {medium.label}
    </span>
  </div>
  <div class="rec-body" data-home-layout-recommendation={layoutMotion ? '' : undefined}>
    <p class="rec-meta">
      <span class="rec-medium-inline">{medium.label}</span>
      {item.data.source && <span>{item.data.source}</span>}
      <time datetime={item.data.date.toISOString()}>{formattedDate}</time>
    </p>
    <Heading class="rec-title">
      <a href={item.data.url}>
        {item.data.title}<span aria-hidden="true"> ↗</span><span class="sr-only"> (external site)</span>
      </a>
    </Heading>
    {item.data.author && <p class="rec-author">By {item.data.author}</p>}
    {item.data.take && (
      <div class="rec-take">
        <span class="rec-take-label">My thoughts</span>
        <p>{item.data.take}</p>
      </div>
    )}
  </div>
</article>
