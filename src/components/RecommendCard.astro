---
import type { CollectionEntry } from 'astro:content';

interface Props {
  item: CollectionEntry<'recommends'>;
  motion?: boolean;
  headingLevel?: 2 | 3;
}

const { item, motion = false, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const mediumMeta = {
  read: { label: 'Read', path: 'M6 4.75h8a3 3 0 0 1 3 3v11.5h-8a3 3 0 0 0-3 3V4.75Zm12 0h.5a2.5 2.5 0 0 1 2.5 2.5v12h-9a3 3 0 0 0-3 3' },
  watch: { label: 'Watch', path: 'm9 7 10 5-10 5V7Zm-3-3.25h12A3.25 3.25 0 0 1 21.25 7v10A3.25 3.25 0 0 1 18 20.25H6A3.25 3.25 0 0 1 2.75 17V7A3.25 3.25 0 0 1 6 3.75Z' },
  listen: { label: 'Listen', path: 'M4 13v-1a8 8 0 0 1 16 0v1M4 13h2.5A1.5 1.5 0 0 1 8 14.5v4A1.5 1.5 0 0 1 6.5 20H6a2 2 0 0 1-2-2v-5Zm16 0h-2.5a1.5 1.5 0 0 0-1.5 1.5v4a1.5 1.5 0 0 0 1.5 1.5h.5a2 2 0 0 0 2-2v-5Z' },
};
const medium = mediumMeta[item.data.medium];
const formattedDate = item.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
---
<article
  class:list={['rec', { 'rec-has-image': item.data.image, 'rec-no-image': !item.data.image }]}
  data-recommendation
  data-medium={item.data.medium}
  data-motion-beat={motion ? '' : undefined}
>
  <div class:list={['rec-visual', { 'rec-visual-fallback': !item.data.image }]}>
    {item.data.image ? (
      <img
        class="rec-thumb"
        src={item.data.image}
        alt=""
        width="640"
        height="360"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <svg class="rec-medium-mark" viewBox="0 0 24 24" aria-hidden="true">
        <path d={medium.path}></path>
      </svg>
    )}
    <span class="rec-medium">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d={medium.path}></path></svg>
      {medium.label}
    </span>
  </div>
  <div class="rec-body">
    <p class="rec-meta">
      <span class="rec-medium-inline">{medium.label}</span>
      {item.data.source && <span>{item.data.source}</span>}
      <time datetime={item.data.date.toISOString()}>{formattedDate}</time>
    </p>
    <Heading class="rec-title">
      <a href={item.data.url}>
        {item.data.title}<span aria-hidden="true"> ↗</span><span class="sr-only"> (external site)</span>
      </a>
    </Heading>
    {item.data.author && <p class="rec-author">By {item.data.author}</p>}
    {item.data.take && (
      <div class="rec-take">
        <span class="rec-take-label">My thoughts</span>
        <p>{item.data.take}</p>
      </div>
    )}
  </div>
</article>
