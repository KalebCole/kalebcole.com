---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PinnedRepos from '../components/PinnedRepos.astro';
import PinnedWriting from '../components/PinnedWriting.astro';
import Polaroid from '../components/Polaroid.astro';
import RecommendCard from '../components/RecommendCard.astro';
import WritingRow from '../components/WritingRow.astro';
import { ELSEWHERE_LINKS } from '../lib/elsewhere.mjs';
import { getPublishedRecommends } from '../lib/recommends';
import { HOMEPAGE_SOCIAL_IMAGE } from '../lib/social-image.mjs';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const [pinnedPost, ...writingRows] = recentPosts;
const HOME_PROJECT_LIMIT = 2;
const HOME_RECOMMENDATION_LIMIT = 3;
const recentRecommendations = (await getPublishedRecommends()).slice(0, HOME_RECOMMENDATION_LIMIT);
const homepageDescription = 'I share what interests me here, along with things that might help someone else learn.';
---
<Layout
  title="Kaleb Cole"
  description={homepageDescription}
  {...HOMEPAGE_SOCIAL_IMAGE}
>
  <main id="main-content" class="site-shell home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <h1 id="home-title" class="home-greeting" data-home-layout-hero>Hi, I’m Kaleb.</h1>
      <Polaroid />
      <p class="home-statement" data-home-layout-hero>I make things, write down what I learn, and follow whatever has me <span class="home-accent">curious</span> right now.</p>
      <p class="home-subtitle" data-home-layout-hero>I’m a software engineer at Microsoft, building what interests me and designing how we work with agents.</p>
      <div class="home-actions" aria-label="Explore my work" data-home-layout-hero>
        <a class="home-action home-action-primary" href="/projects">See my projects</a>
        <a class="home-action" href="/blog">Read my writing</a>
      </div>
      <section class="home-elsewhere" aria-label="Elsewhere" data-home-layout-hero>
        <span class="home-elsewhere-label">Elsewhere</span>
        <nav class="home-elsewhere-links" aria-label="Elsewhere">
          {ELSEWHERE_LINKS.map((link) => (
            <a href={link.href} aria-label={link.accessibleName}>
              {link.label} <span aria-hidden="true">↗</span>
            </a>
          ))}
        </nav>
      </section>
    </section>

    <section class="recent-projects" aria-labelledby="recent-projects-title">
      <div class="recent-heading" data-motion-beat>
        <h2 id="recent-projects-title">Recent projects</h2>
      </div>
      <PinnedRepos limit={HOME_PROJECT_LIMIT} variant="home" layoutMotion />
      <a class="all-projects-link" data-motion-beat href="/projects">All projects <span aria-hidden="true">→</span></a>
    </section>

    <section class="recent-writing" aria-labelledby="recent-title">
      <div class="recent-heading" data-motion-beat>
        <h2 id="recent-title">Recent writing</h2>
      </div>
      {pinnedPost && <PinnedWriting post={pinnedPost} motion layoutMotion headingLevel={3} />}
      <div class="writing-list">
        {writingRows.map((post) => <WritingRow post={post} motion layoutMotion />)}
        <a class="all-writing-link" data-motion-beat href="/blog">All writing <span aria-hidden="true">→</span></a>
      </div>
    </section>

    {recentRecommendations.length > 0 && (
      <section class="recent-recommendations" aria-labelledby="recent-recommendations-title">
        <div class="recent-heading" data-motion-beat>
          <h2 id="recent-recommendations-title">Recent recommendations</h2>
        </div>
        <div class="recommendations-list">
          {recentRecommendations.map((item) => <RecommendCard item={item} motion layoutMotion headingLevel={3} />)}
          <a class="all-recommendations-link" data-motion-beat href="/recommends">
            All recommendations <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    )}
  </main>

  <script>
    import { initHomeBreakpointMotion } from '../scripts/home-breakpoint-motion.mjs';
    import { initPublicationMotion } from '../scripts/publication-motion.mjs';

    initHomeBreakpointMotion();
    initPublicationMotion();
  </script>
</Layout>