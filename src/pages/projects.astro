---
import Layout from '../layouts/Layout.astro';
import PinnedRepos from '../components/PinnedRepos.astro';
---
<Layout title="Projects | Kaleb Cole" description="Things Kaleb Cole has made or is exploring.">
  <main id="main-content" class="site-shell projects-page">
    <header class="page-heading" data-motion-beat>
      <h1>Projects</h1>
      <p>Things I’ve built, contributed to, or am currently working on.</p>
    </header>
    <PinnedRepos />
    <a class="all-projects-link" data-motion-beat href="https://github.com/KalebCole?tab=repositories" aria-label="See all projects on GitHub, external site">See all projects <span aria-hidden="true">↗</span></a>
  </main>

  <script>
    import { initPublicationMotion } from '../scripts/publication-motion.mjs';

    initPublicationMotion();
  </script>
</Layout>
