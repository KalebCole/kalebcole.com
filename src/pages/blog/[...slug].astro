---
import { getCollection, render } from 'astro:content';
import Post from '../../layouts/Post.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, nextPost: posts[index + 1] },
  }));
}

const { post, nextPost } = Astro.props;
const { Content } = await render(post);
const plainText = post.body
  .replace(/```[\s\S]*?```/g, ' ')
  .replace(/<[^>]+>|[#>*_`[\]()!-]/g, ' ')
  .replace(/\s+/g, ' ')
  .trim();
const readingMinutes = Math.max(1, Math.ceil(plainText.split(' ').filter(Boolean).length / 200));
---
<Post
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  updated={post.data.updated}
  tags={post.data.tags}
  readingMinutes={readingMinutes}
  hasXPost={/^```x-post\b/m.test(post.body ?? '')}
  nextPost={nextPost ? { href: `/blog/${nextPost.id}`, title: nextPost.data.title } : undefined}
>
  <Content />
</Post>