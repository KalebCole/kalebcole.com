---
import { getCollection } from 'astro:content';
import PinnedWriting from '../../components/PinnedWriting.astro';
import WritingRow from '../../components/WritingRow.astro';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const [pinned, ...archive] = posts;

const groups = new Map<number, typeof archive>();
for (const post of archive) {
  const year = post.data.date.getUTCFullYear();
  if (!groups.has(year)) groups.set(year, []);
  groups.get(year)!.push(post);
}
const years = [...groups.keys()];
---
<Layout title="Writing | Kaleb Cole">
  <main id="main-content" class="site-shell writing-page">
    <header class="page-heading">
      <h1>Writing</h1>
      <p>Notes, essays, and half-finished thoughts.</p>
    </header>

    {pinned ? (
      <PinnedWriting post={pinned} />
    ) : (
      <p class="empty-state">Nothing here yet.</p>
    )}

    {archive.length > 0 && (
      <div class="writing-archive">
        {years.map((year) => (
          <section aria-labelledby={`year-${year}`}>
            <h2 id={`year-${year}`} class="year-heading">{year}</h2>
            <div class="writing-list">
              {groups.get(year)!.map((post) => <WritingRow post={post} />)}
            </div>
          </section>
        ))}
      </div>
    )}
  </main>
</Layout>