---
import Layout from './Layout.astro';
import { HOMEPAGE_SOCIAL_IMAGE } from '../lib/social-image.mjs';
import { blogPostingSchema } from '../lib/json-ld.mjs';

interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  tags: string[];
  readingMinutes: number;
  nextPost?: { href: string; title: string };
}
const { title, description, date, updated, tags, readingMinutes, nextPost } = Astro.props;
const jsonLd = blogPostingSchema({
  title,
  description,
  url: new URL(Astro.url.pathname, Astro.site),
  date,
  updated,
});
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });
---
<Layout title={`${title} | Kaleb Cole`} description={description} type="article" jsonLd={jsonLd} {...HOMEPAGE_SOCIAL_IMAGE}>
  <main id="main-content" class="site-shell article-page">
    <article>
      <header class="article-header">
        <a class="back-link" href="/blog">← Writing</a>
        <h1>{title}</h1>
        <p class="article-summary">{description}</p>
        <p class="meta-line">
          <time datetime={date.toISOString()}>{fmt(date)}</time>
          <span>{readingMinutes} min read</span>
          {tags.length > 0 && <span>{tags.join(' · ')}</span>}
          {updated && <span>Updated <time datetime={updated.toISOString()}>{fmt(updated)}</time></span>}
        </p>
      </header>
      <div class="prose">
        <slot />
      </div>
      <footer class="article-ending">
        <div class="article-signoff">
          <p>– Kaleb</p>
          <time datetime={date.toISOString()}>
            {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
          </time>
        </div>
        <nav class="article-onward" aria-label="Continue reading">
          <a href="/blog">← All writing</a>
          {nextPost && <a href={nextPost.href}>Next: {nextPost.title} →</a>}
        </nav>
      </footer>
    </article>
  </main>
  <dialog class="media-dialog" aria-label="Expanded article media">
    <div class="media-dialog-content">
      <button class="media-dialog-close" type="button" aria-label="Close expanded media">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
          <path d="M5 5l14 14M19 5 5 19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
      <div class="media-dialog-asset"></div>
    </div>
  </dialog>
</Layout>

<script>
  import '../scripts/article-media.mjs';
</script>
