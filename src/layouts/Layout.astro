---
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { resolveSocialImageOrigin } from '../lib/site-origin.mjs';
import { PERSON_SCHEMA } from '../lib/person-schema.mjs';

interface Props {
  title: string;
  description?: string;
  feedHref?: string;
  feedTitle?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  imageType?: `image/${string}`;
  type?: 'website' | 'article';
  personSchema?: boolean;
}
const {
  title,
  description = 'Kaleb Cole’s public workshop for ideas, experiences, interests, and projects.',
  feedHref = '/rss.xml',
  feedTitle = 'Kaleb Cole | Writing feed',
  image,
  imageWidth,
  imageHeight,
  imageAlt,
  imageType,
  type = 'website',
  personSchema = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = image ? new URL(image, resolveSocialImageOrigin(process.env)) : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f8fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111625" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:secure_url" content={socialImage} />}
    {socialImage && imageType && <meta property="og:image:type" content={imageType} />}
    {socialImage && imageWidth && <meta property="og:image:width" content={imageWidth} />}
    {socialImage && imageHeight && <meta property="og:image:height" content={imageHeight} />}
    {socialImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonical} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {socialImage && imageWidth && <meta name="twitter:image:width" content={imageWidth} />}
    {socialImage && imageHeight && <meta name="twitter:image:height" content={imageHeight} />}
    {socialImage && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    <link rel="alternate" type="application/rss+xml" title={feedTitle} href={feedHref} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    {personSchema && <script type="application/ld+json" set:html={JSON.stringify(PERSON_SCHEMA)} />}

    <script is:inline>
      (function () {
        var systemDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        try {
          var saved = localStorage.getItem('theme-mode');
          var mode = saved === 'dark' || saved === 'light' ? saved : (systemDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-mode', mode);
        } catch (e) {
          document.documentElement.setAttribute('data-mode', systemDark ? 'dark' : 'light');
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <SiteNav feedHref={feedHref} feedTitle={feedTitle} />
    </header>
    <slot />
    <SiteFooter />
  </body>
</html>
