{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEO and AEO eval queries",
  "type": "object",
  "required": ["version", "updated", "queries"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "updated": { "type": "string", "format": "date" },
    "note": { "type": "string" },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "prompt", "group", "qualified", "enabled", "requiredFactIds", "desiredFactIds"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "prompt": { "type": "string", "minLength": 1 },
          "group": { "enum": ["identity"] },
          "qualified": { "type": "boolean" },
          "enabled": { "type": "boolean" },
          "requiredFactIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "desiredFactIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    }
  }
}
