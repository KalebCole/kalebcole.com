{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEO and AEO eval config",
  "type": "object",
  "required": ["version", "updated", "locale", "repeats", "envFiles", "artifactsDir", "limits", "providers"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "updated": { "type": "string", "format": "date" },
    "locale": {
      "type": "object",
      "required": ["country", "language", "location", "device", "timeZone"],
      "additionalProperties": false,
      "properties": {
        "country": { "type": "string" },
        "language": { "type": "string" },
        "location": { "type": "string" },
        "device": { "enum": ["desktop", "mobile"] },
        "timeZone": { "type": "string" }
      }
    },
    "repeats": { "type": "integer", "minimum": 1, "maximum": 5 },
    "envFiles": { "type": "array", "items": { "type": "string" } },
    "artifactsDir": { "type": "string", "minLength": 1 },
    "limits": {
      "type": "object",
      "required": ["maxRequestsPerRun", "maxRetries", "retryBaseDelayMs", "maxCostUsdPerRun"],
      "additionalProperties": false,
      "properties": {
        "maxRequestsPerRun": { "type": "integer", "minimum": 0, "maximum": 500 },
        "maxRetries": { "type": "integer", "minimum": 0, "maximum": 5 },
        "retryBaseDelayMs": { "type": "integer", "minimum": 0 },
        "maxCostUsdPerRun": { "type": "number", "minimum": 0, "maximum": 20 }
      }
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "adapter", "surface", "label", "enabled", "requiredEnv", "costPerCallUsdUpper", "maxCallsPerRun", "citations", "organic"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "adapter": { "type": ["string", "null"] },
          "plannedIssue": { "type": "integer" },
          "surface": { "type": "string" },
          "label": { "enum": ["fixture", "serp-capture", "api-proxy", "manual-ui"] },
          "enabled": { "type": "boolean" },
          "requiredEnv": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } },
          "costPerCallUsdUpper": { "type": "number", "minimum": 0 },
          "maxCallsPerRun": { "type": "integer", "minimum": 0 },
          "citations": { "type": "boolean" },
          "organic": { "type": "boolean" }
        }
      }
    }
  }
}
