{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEO and AEO eval facts",
  "type": "object",
  "required": ["status", "version", "updated", "approval", "facts"],
  "additionalProperties": false,
  "properties": {
    "status": { "enum": ["pending-approval", "approved"] },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "updated": { "type": "string", "format": "date" },
    "note": { "type": "string" },
    "approval": {
      "type": "object",
      "required": ["status", "approvedBy", "approvedAt"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["pending", "approved"] },
        "approvedBy": { "type": ["string", "null"] },
        "approvedAt": { "type": ["string", "null"] },
        "instructions": { "type": "string" }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "subject", "claim", "value", "distinguishing", "match", "contradict", "sources", "verifiedAt", "approval"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^(target|namesake)-[a-z0-9-]+$" },
          "subject": { "enum": ["target", "namesake"] },
          "claim": { "type": "string", "minLength": 1 },
          "value": { "type": "string", "minLength": 1 },
          "distinguishing": { "type": "boolean" },
          "match": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "contradict": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["url", "title", "publisher", "retrieved", "quote"],
              "additionalProperties": false,
              "properties": {
                "url": { "type": "string", "format": "uri" },
                "title": { "type": "string", "minLength": 1 },
                "publisher": { "type": "string", "minLength": 1 },
                "published": { "type": "string", "format": "date" },
                "retrieved": { "type": "string", "format": "date" },
                "quote": { "type": "string", "minLength": 1 }
              }
            }
          },
          "verifiedAt": { "type": "string", "format": "date" },
          "approval": { "enum": ["pending", "approved", "rejected"] }
        }
      }
    }
  }
}
